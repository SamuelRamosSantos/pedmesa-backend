# Copie para .env.test (ignorado pelo Git). Usado só pela suíte de testes.
# O DB_NAME precisa terminar em _test e o DB_HOST precisa ser local:
# a suíte se recusa a rodar contra qualquer outro banco.
NODE_ENV=test
PORT=3001
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=pedmesa_test_user
DB_PASSWORD=pedmesa_test_password
DB_NAME=pedmesa_test

JWT_SECRET=segredo-somente-para-testes
JWT_EXPIRES_IN=1h
SUPER_ADMIN_JWT_SECRET=outro-segredo-somente-para-testes

SUPER_ADMIN_EMAIL=superadmin@pedmesa.test
SUPER_ADMIN_SENHA=senha-somente-para-testes

PRINT_FAILURE_RATE=0

# Uploads em disco local durante os testes
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
PUBLIC_URL_BASE=http://localhost:3001
