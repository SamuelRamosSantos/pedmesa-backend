{
  "name": "pedmesa-backend",
  "version": "1.0.0",
  "description": "API do PedMesa - sistema multi-tenant de gestão de comandas, pedidos e divisão de conta.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "seed": "tsx src/database/seeds/initial-seed.ts",
    "seed:super-admin": "tsx src/database/seeds/super-admin-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && biome check --error-on-warnings",
    "format": "biome check --write",
    "lint": "biome lint",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}
