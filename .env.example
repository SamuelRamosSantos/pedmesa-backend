# Aplicação
PORT=3000
NODE_ENV=development
# Origens (separadas por vírgula) autorizadas a chamar a API via CORS
CORS_ORIGIN=http://localhost:5173

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pedmesa_user
DB_PASSWORD=pedmesa_password
DB_NAME=pedmesa_db

# Autenticação
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Autenticação do super-admin (secret separado de propósito — ver PED-40)
SUPER_ADMIN_JWT_SECRET=replace_with_another_long_random_secret

# Credenciais usadas pelo seed:super-admin (npm run seed:super-admin)
SUPER_ADMIN_EMAIL=superadmin@pedmesa.com
SUPER_ADMIN_SENHA=replace_with_a_real_password

# Impressão térmica (fila assíncrona)
# Taxa (0 a 1) de falha simulada da impressora mock, útil para testar o retry do PrintQueue. 0 = nunca falha.
PRINT_FAILURE_RATE=0
