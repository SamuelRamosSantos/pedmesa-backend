# Aplicação
PORT=3000
NODE_ENV=development
# Origens (separadas por vírgula) autorizadas a chamar a API via CORS
# 5173 = pedmesa-frontend, 5174 = pedmesa-site (landing page)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pedmesa_user
DB_PASSWORD=pedmesa_password
DB_NAME=pedmesa_db

# Autenticação
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Autenticação do super-admin (secret separado de propósito — ver PED-40)
SUPER_ADMIN_JWT_SECRET=replace_with_another_long_random_secret

# Credenciais usadas pelo seed:super-admin (npm run seed:super-admin)
SUPER_ADMIN_EMAIL=superadmin@pedmesa.com
SUPER_ADMIN_SENHA=replace_with_a_real_password

# Impressão térmica (fila assíncrona)
# Taxa (0 a 1) de falha simulada da impressora mock, útil para testar o retry do PrintQueue. 0 = nunca falha.
PRINT_FAILURE_RATE=0

# Upload/armazenamento de imagens (PED-45)
# "local" (padrão, salva em disco e serve via GET /uploads/*) ou "s3" (produção).
STORAGE_DRIVER=local

# Usado só com STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# Base pública usada para montar a URL do arquivo salvo em disco (ex.: https://api.pedmesa.com.br em produção).
PUBLIC_URL_BASE=http://localhost:3000

# Usado só com STORAGE_DRIVER=s3 — funciona com qualquer serviço compatível com S3
# (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, Backblaze B2, etc.)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" para provedores que exigem path-style addressing (ex.: MinIO, R2). AWS S3 real não precisa.
S3_FORCE_PATH_STYLE=false
# Base pública de onde os arquivos ficam acessíveis (bucket público ou CDN na frente dele).
S3_PUBLIC_URL_BASE=
