# Aplicação
PORT=3000
NODE_ENV=development

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pedmesa_user
DB_PASSWORD=pedmesa_password
DB_NAME=pedmesa_db

# Autenticação
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Impressão térmica (fila assíncrona)
# Taxa (0 a 1) de falha simulada da impressora mock, útil para testar o retry do PrintQueue. 0 = nunca falha.
PRINT_FAILURE_RATE=0
