# Aplicação
PORT=3000
NODE_ENV=development
# Origens (separadas por vírgula) autorizadas a chamar a API via CORS
# 5173 = pedmesa-frontend, 5174 = pedmesa-site (landing page)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pedmesa_user
DB_PASSWORD=pedmesa_password
DB_NAME=pedmesa_db

# Autenticação
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Autenticação do super-admin (secret separado de propósito — ver PED-40)
SUPER_ADMIN_JWT_SECRET=replace_with_another_long_random_secret

# Credenciais usadas pelo seed:super-admin (npm run seed:super-admin)
SUPER_ADMIN_EMAIL=superadmin@pedmesa.com
SUPER_ADMIN_SENHA=replace_with_a_real_password

# Impressão térmica (fila assíncrona)
# Taxa (0 a 1) de falha simulada da impressora mock, útil para testar o retry do PrintQueue. 0 = nunca falha.
PRINT_FAILURE_RATE=0

# Imagens no Cloudflare R2 (PED-45). Sem estas variáveis a API não sobe.
# Dev e homologação: bucket pedmesa-imagens-dev; produção: pedmesa-imagens.
# Token de API do R2 com permissão "Object Read & Write" restrita ao bucket.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pedmesa-imagens-dev
# Domínio público do bucket (https). Dev: https://cdn-dev.pedmesa.com.br
# (ou o endereço *.r2.dev do bucket enquanto o domínio não estiver ativo).
# Produção: https://cdn.pedmesa.com.br
R2_PUBLIC_URL_BASE=https://cdn-dev.pedmesa.com.br

# Rate limiting (PED-78) — janelas em milissegundos.
# Limite geral, aplicado em toda a API.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
# Limite de POST /auth/login — bem mais restritivo, conta só tentativas que falham.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=6
